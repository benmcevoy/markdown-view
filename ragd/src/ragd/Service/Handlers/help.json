{
  "openapi": "3.0.0",
  "info": {
    "title": "Rag Service",
    "version": "0.0.1"
  },
  "paths": {
    "/status": {
      "get": {
        "summary": "Get status of daemon.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/response"
                }
              }
            }
          }
        }
      }
    },
    "/stop": {
      "post": {
        "summary": "Stop the daemon.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/response"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {},
    "schemas": {
      "response": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "maxLength": 256,
            "description": "A status code, e.g. OK,RUNNING,STOPPED,ERROR"
          },
          "message": {
            "type": "string",
            "maxLength": 1024,
            "description": "A text message describing the response"
          },
          "body": {
            "type": "object",
            "description": "Response payload"
          }
        }
      }
    }
  }
}